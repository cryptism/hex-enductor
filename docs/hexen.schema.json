{
  "$ref": "#/definitions/HexenProject",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "FogOfWar": {
      "additionalProperties": false,
      "description": "A Location's fog-of-war state. Presence on a Location (even with no revealed cells) means fog is on; absence means the map is fully visible. Cell keys are opaque to the server — whatever addressing scheme the client's fog overlay uses (see packages/map-core/src/fog.ts) — so this message never needs to know the map's grid or image dimensions.",
      "properties": {
        "revealedCells": {
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "Grid": {
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "hex",
                  "square"
                ]
              }
            ]
          }
        }
      ],
      "description": "How a Location's own map surface is calibrated, if it has one.",
      "minProperties": 1,
      "properties": {
        "hex": {
          "anyOf": [
            {
              "$ref": "#/definitions/HexGrid"
            },
            {
              "type": "null"
            }
          ]
        },
        "square": {
          "anyOf": [
            {
              "$ref": "#/definitions/SquareGrid"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "GridStyle": {
      "additionalProperties": false,
      "description": "Visual styling for a grid overlay's lines.",
      "properties": {
        "color": {
          "description": "CSS color for the grid lines.",
          "type": "string"
        },
        "opacity": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Defaults to 0.45 when absent — same presence caveat as `weight`."
        },
        "weight": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Grid line stroke width, in pixels. Defaults to 1 when absent — proto3's implicit zero-value doesn't match that default, so this is `optional` (tracked presence) rather than a plain field. Apply the default explicitly wherever a GridStyle is constructed or read."
        }
      },
      "type": "object"
    },
    "HexGrid": {
      "additionalProperties": false,
      "description": "A hex lattice calibrated by an origin plus two basis vectors — see packages/map-core/src/hexMath.ts for the math this feeds.",
      "properties": {
        "b1": {
          "anyOf": [
            {
              "$ref": "#/definitions/Point"
            },
            {
              "type": "null"
            }
          ],
          "description": "Vector from origin to one neighbouring hex's centre."
        },
        "b2": {
          "anyOf": [
            {
              "$ref": "#/definitions/Point"
            },
            {
              "type": "null"
            }
          ],
          "description": "Vector from origin to a second neighbouring hex's centre, not parallel to b1."
        },
        "distancePerCell": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Real-world distance one hex represents (e.g. km), for ruler readouts. Genuinely optional — absent means \"no ruler\"."
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/definitions/Point"
            },
            {
              "type": "null"
            }
          ],
          "description": "Pixel position of one hex's centre."
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/definitions/GridStyle"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "HexenProject": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "anyOf": [
            {
              "$ref": "#/definitions/ProjectContent"
            },
            {
              "type": "null"
            }
          ]
        },
        "defaultLocation": {
          "type": "string"
        },
        "locations": {
          "items": {
            "$ref": "#/definitions/Location"
          },
          "type": "array"
        },
        "schemaVersion": {
          "type": "integer"
        },
        "title": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "ImageRef": {
      "additionalProperties": false,
      "description": "A Location's own base map image, if it has one.",
      "properties": {
        "file": {
          "description": "Path to the base map image, resolved relative to the .hexen.yml file's own directory (not content.vault_root) — image storage is decoupled from wherever the content plugin's root is.",
          "type": "string"
        },
        "height": {
          "type": "integer"
        },
        "width": {
          "type": "integer"
        }
      },
      "type": "object"
    },
    "InlineLocationContent": {
      "additionalProperties": false,
      "description": "A single location's content, written directly into the .hexen.yml — no vault file.",
      "properties": {
        "body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Defaults to \"\" when absent."
        },
        "title": {
          "type": "string"
        }
      },
      "type": "object"
    },
    "InlineProjectContent": {
      "additionalProperties": false,
      "description": "A project's content source: no external vault — each Location carries its own title/body directly in this file.",
      "properties": {},
      "type": "object"
    },
    "Link": {
      "additionalProperties": false,
      "description": "A pin on a parent Location's map: position and display only, never a title or summary — those live on the target Location's own content.",
      "properties": {
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Defaults to null (absent) when unset."
        },
        "hidden": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "description": "Defaults to false when absent."
        },
        "icon": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "description": "This pin's own identity, stable across edits and independent of what it points at — so a Location can be the target of more than one Link (e.g. a front and back door into the same building).",
          "type": "string"
        },
        "target": {
          "description": "The Location this pin points at.",
          "type": "string"
        },
        "type": {
          "description": "Marker type, e.g. settlement/ruin/landmark/hazard/waypoint.",
          "type": "string"
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "description": "The one node type in the format. A Location becomes a map you can click into purely by having a grid, and a pin on someone else's map purely by being the target of a Link elsewhere — both, either, or neither can be true of the same Location at once.",
      "properties": {
        "content": {
          "anyOf": [
            {
              "$ref": "#/definitions/LocationContent"
            },
            {
              "type": "null"
            }
          ]
        },
        "fog": {
          "anyOf": [
            {
              "$ref": "#/definitions/FogOfWar"
            },
            {
              "type": "null"
            }
          ]
        },
        "grid": {
          "anyOf": [
            {
              "$ref": "#/definitions/Grid"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "type": "string"
        },
        "image": {
          "anyOf": [
            {
              "$ref": "#/definitions/ImageRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "links": {
          "items": {
            "$ref": "#/definitions/Link"
          },
          "type": "array"
        }
      },
      "type": "object"
    },
    "LocationContent": {
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "obsidian",
                  "inline"
                ]
              }
            ]
          }
        }
      ],
      "description": "A Location's title/summary/body always come from here, resolved at load time — never duplicated elsewhere. Inline content is the one exception to \"never duplicated into .hexen.yml\": there is nowhere else for it to live.",
      "minProperties": 1,
      "properties": {
        "inline": {
          "anyOf": [
            {
              "$ref": "#/definitions/InlineLocationContent"
            },
            {
              "type": "null"
            }
          ]
        },
        "obsidian": {
          "anyOf": [
            {
              "$ref": "#/definitions/ObsidianLocationContent"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ObsidianLocationContent": {
      "additionalProperties": false,
      "description": "A single location's content: one file in the project's Obsidian vault.",
      "properties": {
        "ref": {
          "description": "Path to the markdown file, relative to the project's content.vault_root.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "ObsidianProjectContent": {
      "additionalProperties": false,
      "description": "A project's content source: an Obsidian vault.",
      "properties": {
        "vaultRoot": {
          "description": "Path to the Obsidian vault, resolved relative to the .hexen.yml file's own directory.",
          "type": "string"
        }
      },
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "description": "A pixel coordinate in the map image's own coordinate space.",
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "type": "object"
    },
    "ProjectContent": {
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "obsidian",
                  "inline"
                ]
              }
            ]
          }
        }
      ],
      "description": "Where a project's location content (title/summary/body) is resolved from.",
      "minProperties": 1,
      "properties": {
        "inline": {
          "anyOf": [
            {
              "$ref": "#/definitions/InlineProjectContent"
            },
            {
              "type": "null"
            }
          ]
        },
        "obsidian": {
          "anyOf": [
            {
              "$ref": "#/definitions/ObsidianProjectContent"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "SquareGrid": {
      "additionalProperties": false,
      "description": "A square lattice.",
      "properties": {
        "cellSize": {
          "anyOf": [
            {
              "$ref": "#/definitions/Point"
            },
            {
              "type": "null"
            }
          ],
          "description": "Width and height of one grid cell, in pixels."
        },
        "distancePerCell": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "anyOf": [
            {
              "$ref": "#/definitions/Point"
            },
            {
              "type": "null"
            }
          ],
          "description": "Pixel position of one cell's top-left corner."
        },
        "style": {
          "anyOf": [
            {
              "$ref": "#/definitions/GridStyle"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    }
  },
  "description": "Generated from schema/hexen/v1/*.proto by `cargo run -p hexen-cli -- schema`. Don't edit by hand.",
  "title": "Hex Enductor project (.hexen.yml)"
}
