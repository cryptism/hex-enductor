{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hex Enductor",
  "mainBinaryName": "hex-enductor",
  "version": "0.0.0",
  "identifier": "net.cryptism.hex-enductor",
  "build": {
    "frontendDist": "../editor-rs/dist",
    "beforeBuildCommand": {
      "script": "trunk build --release --config ../editor-rs/Trunk.toml && trunk build --release --config ../presentation-rs/Trunk.toml --public-url /presentation/ --dist ../desktop/presentation-dist",
      "cwd": "."
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png"]
  }
}
